# Copia este archivo como .env.local y llena los valores de tu proyecto de Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps > App web)
VITE_FIREBASE_API_KEY= 
VITE_FIREBASE_AUTH_DOMAIN= 
VITE_FIREBASE_PROJECT_ID= 
VITE_FIREBASE_STORAGE_BUCKET= 
VITE_FIREBASE_MESSAGING_SENDER_ID= 
VITE_FIREBASE_APP_ID= 

# Dominio institucional permitido para registrarse
VITE_ALLOWED_DOMAIN=uvp.edu.mx

# Biblioteca: llave de Google Books (Google Cloud Console > APIs y servicios > Credenciales). Opcional, pero evita el límite de consultas
VITE_GOOGLE_BOOKS_API_KEY=

# Notas de clase (todas opcionales; la sección avisa qué falta). Ver README, sección «Notas de clase».
# Cloudinary: fotos de libreta (upload preset en modo Unsigned)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Google Drive: PDFs en el Drive del alumno (OAuth Client ID de tipo «Aplicación web»)
VITE_GOOGLE_CLIENT_ID=
# Gemini: extracción de texto (OCR), resúmenes y tarjetas automáticas
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-flash-latest

# Aviso por correo al compartir un apunte: EmailJS (gratis, 200 correos/mes). Ver README, sección «Correos sin plan Blaze»
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_SHARE=
VITE_EMAILJS_PUBLIC_KEY=

# Opcional: correo para ampliar el límite diario del traductor de la trivia (MyMemory: 5 000 -> 50 000 caracteres/día)
VITE_MYMEMORY_EMAIL=

# Graficadora (Desmos): llave gratuita en https://www.desmos.com/api (en desarrollo se usa la llave de demostracion)
VITE_DESMOS_API_KEY=

# Programar y retos: por defecto usa la instancia publica gratuita https://ce.judge0.com (con limite de uso)
VITE_JUDGE0_URL=
VITE_JUDGE0_KEY=
# Tutor de errores: llave gratuita de Stack Exchange (opcional, sube el limite diario) https://stackapps.com/apps/oauth/register
VITE_STACKEXCHANGE_KEY=

# Idiomas: instancia propia de LibreTranslate (sin ella se usa MyMemory, gratuita con limite diario)
VITE_LIBRETRANSLATE_URL=
VITE_LIBRETRANSLATE_KEY=
# Diccionario avanzado: llave gratuita de Wordnik https://developer.wordnik.com
VITE_WORDNIK_API_KEY=
# Corrector: servidor propio de LanguageTool (opcional; por defecto la API publica gratuita)
VITE_LANGUAGETOOL_URL=

# Indicadores de Mexico (INEGI): token gratuito https://www.inegi.org.mx/servicios/api_indicadores.html
VITE_INEGI_TOKEN=
