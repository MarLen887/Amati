rules_version = '2';

// Reglas de seguridad de Amati
// - Solo cuentas @uvp.edu.mx con correo verificado acceden a datos de estudio.
// - Cada estudiante solo puede leer/modificar sus propias materias, tarjetas y sesiones.
// - Los datos de investigación (prueba piloto) se guardan con un ID anónimo y solo
//   los administradores (colección `admins`, editable desde la consola) pueden leerlos.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function uvp() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('^[^@]+@uvp[.]edu[.]mx$');
    }
    function verified() {
      return uvp() && request.auth.token.email_verified == true;
    }
    function isOwner(uid) {
      return verified() && request.auth.uid == uid;
    }
    function isAdmin() {
      return verified()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }
    function myAnonId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.anonId;
    }
    function isText(v, max) {
      return v is string && v.size() <= max;
    }
    function validSubject() {
      let d = request.resource.data;
      return isText(d.name, 80) && d.name.size() > 0 && isText(d.color, 20);
    }
    function validCard() {
      let d = request.resource.data;
      // Cada lado necesita texto o imagen
      return isText(d.front, 2000) && (d.front.size() > 0 || d.get('frontImage', null) != null)
        && isText(d.back, 4000) && (d.back.size() > 0 || d.get('backImage', null) != null)
        && isText(d.topic, 80)
        && d.subjectId is string
        && d.dueDate is timestamp
        && d.ease is number && d.interval is number && d.reps is number;
    }
    function validNote() {
      let d = request.resource.data;
      return isText(d.title, 200)
        && d.type in ['feynman', 'cornell', 'outline', 'pq4r', 'sq3r', 'srl', 'libre']
        && isText(d.subjectId, 100)
        && isText(d.topic, 80)
        && d.content is map
        && d.get('collaboratorEmails', []) is list
        && d.get('collaboratorEmails', []).size() <= 30;
    }
    // Apuntes compartidos: el dueño agrega correos en collaboratorEmails; quien esté en esa lista puede editar
    function isCollabOf(data) {
      return verified() && request.auth.token.email.lower() in data.get('collaboratorEmails', []);
    }
    function isCollab(uid, noteId) {
      return isCollabOf(get(/databases/$(database)/documents/users/$(uid)/notes/$(noteId)).data);
    }
    function validLibro() {
      let d = request.resource.data;
      return d.kind in ['book', 'pdf'] && isText(d.title, 300) && isText(d.subjectId, 100)
        && isText(d.author, 200) && isText(d.source, 40) && isText(d.description, 2000)
        && d.authors is list && d.authors.size() <= 6;
    }
    function validTrivia() {
      let d = request.resource.data;
      return d.total is int && d.total >= 1 && d.total <= 50
        && d.correct is int && d.correct >= 0 && d.correct <= d.total
        && isText(d.category, 80);
    }
    function validEvent() {
      let d = request.resource.data;
      return isText(d.title, 100) && d.title.size() > 0
        && d.kind in ['class', 'activity', 'study']
        && d.recur in ['weekly', 'none']
        && d.startMin is int && d.endMin is int && d.startMin >= 0 && d.endMin <= 1440 && d.endMin > d.startMin
        && d.get('days', []) is list && d.get('days', []).size() <= 7
        && isText(d.get('date', ''), 10)
        && isText(d.get('reason', ''), 200)
        && d.get('status', 'approved') in ['proposed', 'approved', 'done', 'skipped'];
    }
    function validStudyLog() {
      let d = request.resource.data;
      return d.minutes is int && d.minutes >= 1 && d.minutes <= 600
        && isText(d.dayKey, 10) && isText(d.label, 100) && isText(d.get('blockId', ''), 100);
    }
    function validClassNote() {
      let d = request.resource.data;
      return isText(d.title, 200) && isText(d.subjectId, 100) && isText(d.text, 150000)
        && (d.get('file', null) == null || d.file is map);
    }

    // Perfil del usuario
    match /users/{uid} {
      allow read: if uvp() && request.auth.uid == uid;
      allow create: if uvp() && request.auth.uid == uid
        && request.resource.data.anonId is string
        && request.resource.data.email == request.auth.token.email;
      allow update: if uvp() && request.auth.uid == uid
        && request.resource.data.anonId == resource.data.anonId
        && request.resource.data.email == resource.data.email;
      // Borrar mi cuenta: el propio usuario puede eliminar su perfil
      allow delete: if uvp() && request.auth.uid == uid;

      match /subjects/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validSubject();
      }
      match /cards/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCard();
      }
      match /notes/{id} {
        allow read: if isOwner(uid) || isCollabOf(resource.data);
        allow delete: if isOwner(uid);
        allow create: if isOwner(uid) && validNote();
        allow update: if (isOwner(uid) && validNote())
          || (isCollabOf(resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'updatedAt'])
              && validNote());

        // Contenido Yjs (actualizaciones), presencia de cursores e historial: dueño y colaboradores
        match /{sub}/{docId} {
          allow read, create, update, delete: if sub in ['updates', 'presence', 'history']
            && (isOwner(uid) || isCollab(uid, id));
        }
      }
      match /libros/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validLibro();
      }
      match /trivia/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validTrivia();
        allow update: if false;
      }
      match /classNotes/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validClassNote();
      }
      // Agenda: horario, actividades y bloques de estudio (propuestos, aprobados, hechos u omitidos)
      match /events/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validEvent();
      }
      // Tiempo de estudio registrado por tu cuenta (suma a la meta diaria y a la racha)
      match /studyLog/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validStudyLog();
        allow update: if false;
      }
      match /reviews/{id} {
        allow read, create, delete: if isOwner(uid);
        allow update: if false;
      }
      match /sessions/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid);
      }
    }

    // Datos anónimos de la prueba piloto (V de Gowin: registros)
    match /research_sessions/{id} {
      allow create: if verified() && request.resource.data.anonId == myAnonId();
      allow update: if verified() && resource.data.anonId == myAnonId()
        && request.resource.data.anonId == resource.data.anonId;
      allow read: if isAdmin();
      allow delete: if false;
    }
    match /research_reviews/{id} {
      allow create: if verified() && request.resource.data.anonId == myAnonId();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // «Compartidos conmigo» busca en TODOS los apuntes (collection group): sin esta regla Firestore rechaza la consulta
    // aunque la regla de users/{uid}/notes/{id} sí lo permita. Solo da lectura a quien está en collaboratorEmails.
    match /{path=**}/notes/{id} {
      allow read: if isCollabOf(resource.data);
    }

    // Lista de administradores (doc id = correo en minúsculas). Se edita desde la consola.
    match /admins/{email} {
      allow read: if verified() && request.auth.token.email.lower() == email;
      allow write: if false;
    }
  }
}
